DATABASE_URL=postgresql+psycopg://autoscreener:autoscreener@localhost:5432/autoscreener
# 18.6:APIレイヤーは読み取り専用ロールを使う。scripts/create_readonly_role.sql
# 参照(ロール自体はDB初期化後に1回だけ手動で作成する)。
API_DATABASE_URL=postgresql+psycopg://autoscreener_readonly:CHANGE_ME@localhost:5432/autoscreener

# 30.3.1:SEC EDGARが要求する連絡先つきUser-Agent。未設定のままEDGAR関連の
# バッチ(refresh-cik-map / collect-filings / collect-xbrl)を動かすとValueErrorで
# 落ちる(規約違反を黙って犯さないため)。実アドレスをコミットしないこと。
EDGAR_USER_AGENT="TENX personal research <your-address@example.com>"
# 30.8.1:FRED(セントルイス連銀)APIキー。未設定ならマクロ機能(GET /macro・
# collect-macro)全体が無効として扱われる(他の機能はすべて動く)。
# https://fred.stlouisfed.org/docs/api/api_key.html で無料発行できる。
FRED_API_KEY=CHANGE_ME

# K-9:Anthropic APIキー。未設定ならLLM機能(summarize-filings / score-qualitative /
# generate-report)全体が無効として扱われる(他の機能はすべて動く)。
# https://console.anthropic.com/settings/keys で発行できる。
# **注意:これらのコマンドは呼ぶたびに課金される。** config/collection.yaml の
# llm.max_tickers_per_run が1回あたりの上限を決める。
ANTHROPIC_API_KEY=CHANGE_ME

# K-9(ui_llm_provider_selection_2026-08-30.md):config/collection.yaml の
# llm.provider を openai_compat にしたときのキー。ChatGPT なら OpenAI のキー、
# NVIDIA NIM なら NVIDIA のキー、ローカルLLM(Ollama 等)なら任意のダミー文字列。
# 接続先は llm.base_url で指定する(空なら api.openai.com)。
OPENAI_API_KEY=CHANGE_ME
